## It was reviewed and tested by a human committer.

# The developer toolbox on your own machine, in Docker:
#
#   ./developer-toolbox/toolbox up [--config my-toolbox.yaml]
#   ./developer-toolbox/toolbox --help
#
# Needs Docker and Python 3.10 or later. Its own Python packages go into a
# virtual environment under ${TOOLBOX_HOME:-~/.tractusx-developer-toolbox};
# kind, kubectl and Helm are used from your PATH, or downloaded there once.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
home="${TOOLBOX_HOME:-${HOME}/.tractusx-developer-toolbox}"
venv="${home}/venv"

python=""
for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
  if command -v "${candidate}" >/dev/null 2>&1 \
    && "${candidate}" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    python="${candidate}"
    break
  fi
done
if [ -z "${python}" ]; then
  echo "error: the developer toolbox needs Python 3.10 or later." >&2
  exit 1
fi

# The virtual environment is rebuilt whenever requirements.txt changes.
stamp="${venv}/.toolbox-requirements"
if [ ! -x "${venv}/bin/python" ] || ! cmp -s "${here}/requirements.txt" "${stamp}"; then
  echo "Setting up the toolbox's Python environment in ${venv} …" >&2
  "${python}" -m venv "${venv}"
  "${venv}/bin/python" -m pip install --quiet --disable-pip-version-check --requirement "${here}/requirements.txt"
  cp "${here}/requirements.txt" "${stamp}"
fi

exec "${venv}/bin/python" "${here}/scripts/local_toolbox.py" "$@"
